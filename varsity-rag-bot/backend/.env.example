# Optional local overrides; the existing root\.env remains supported.
GROQ_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# PostgreSQL async URL. For local development, sqlite+aiosqlite is also supported.
DATABASE_URL=postgresql+asyncpg://eu_ai:change-this-password@localhost:5432/eu_ai

# Generate a unique secret with:
# .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
